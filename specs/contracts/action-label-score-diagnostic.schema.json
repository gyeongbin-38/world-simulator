{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alifelm:action-label-score-diagnostic:1.0.0",
  "title": "Researcher-only action label sequence score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_hash",
    "context_pack_ref",
    "model_profile_id",
    "model_revision",
    "rendered_input_hash",
    "rendered_input_ref",
    "score_prefix_hash",
    "scores",
    "shared_token_prefixes",
    "treatment_id",
    "treatment_version"
  ],
  "properties": {
    "context_hash": {"$ref": "#/$defs/digest"},
    "context_pack_ref": {"$ref": "#/$defs/digest"},
    "model_profile_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "rendered_input_hash": {"$ref": "#/$defs/digest"},
    "rendered_input_ref": {"$ref": "#/$defs/digest"},
    "score_prefix_hash": {"$ref": "#/$defs/digest"},
    "scores": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mean_log_probability", "model_label", "rank", "token_count", "token_ids", "total_log_probability"],
        "properties": {
          "mean_log_probability": {"type": "number"},
          "model_label": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1, "maximum": 5},
          "token_count": {"type": "integer", "minimum": 1},
          "token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "total_log_probability": {"type": "number"}
        }
      }
    },
    "shared_token_prefixes": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "integer", "minimum": 0}],
        "items": false
      }
    },
    "treatment_id": {"const": "i05r3-action-label-sequence-score"},
    "treatment_version": {"const": "1.0.0"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "x-alifelm-classification": "researcher-only immutable artifact; never model-visible, simulation state, or action-selection authority"
}
