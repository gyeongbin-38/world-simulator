{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alifelm:contract:transition-fragment:0.1.0",
  "title": "A-LifeLM TransitionFragment",
  "description": "Immutable non-authoritative work object staged for a single commit boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragment_id", "tick", "kind", "payload"],
  "properties": {
    "fragment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "tick": { "type": "integer", "minimum": 0 },
    "kind": { "enum": ["MESSAGE", "PROPOSAL_CREATED", "PROPOSAL_REJECTED", "BIRTH_CONFLICT_REJECTED", "BIRTH", "NATURAL_DEATH"] },
    "payload": { "type": "object" }
  }
  ,"oneOf": [
    {
      "properties": {
        "kind": { "const": "MESSAGE" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": { "message": { "$ref": "message-record.schema.json" } }
        }
      }
    },
    {
      "properties": {
        "kind": { "const": "PROPOSAL_CREATED" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal"],
          "properties": { "proposal": { "$ref": "reproduction-proposal.schema.json" } }
        }
      }
    },
    {
      "properties": {
        "kind": { "const": "PROPOSAL_REJECTED" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "actor_id"],
          "properties": {
            "proposal_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
            "actor_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }
          }
        }
      }
    },
    {
      "properties": {
        "kind": { "const": "BIRTH_CONFLICT_REJECTED" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "reason"],
          "properties": {
            "proposal_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
            "reason": { "const": "MULTI_BIRTH_BOUNDARY_CONFLICT" }
          }
        }
      }
    },
    {
      "properties": {
        "kind": { "const": "BIRTH" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "child", "parent_ids", "refractory_until_tick"],
          "properties": {
            "proposal_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
            "child": { "$ref": "agent-state.schema.json" },
            "parent_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }
            },
            "refractory_until_tick": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "properties": {
        "kind": { "const": "NATURAL_DEATH" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id"],
          "properties": {
            "agent_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }
          }
        }
      }
    }
  ],
  "x-alifelm-invariant": "kind and payload are discriminated together"
}
